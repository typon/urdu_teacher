# Copy this file to .env (same folder) and fill in a key for the voice engine you want.
# The first engine with a key is used; force one with URDU_TTS=elevenlabs|uplift|gemini|edge|mac

# ElevenLabs Eleven v4 — https://elevenlabs.io (Profile → API keys)
ELEVENLABS_API_KEY=
# Optional: a voice ID from your ElevenLabs library. Pick a native Urdu speaker from the
# Voice Library (filter Language: Urdu), add it to My Voices, and paste its ID here.
ELEVENLABS_VOICE_ID=

# Uplift AI Orator (Pakistani Urdu) — https://upliftai.org
UPLIFT_API_KEY=
# UPLIFT_VOICE_ID=v_8eelc901

# Google Gemini TTS — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_VOICE=Sulafat

# URDU_TTS=elevenlabs
